# Auto detect text files and normalise their line endings to LF
* text=auto eol=lf

# Shell scripts must keep LF line endings, even on Windows
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts should keep CRLF
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.apk binary
*.aar binary
